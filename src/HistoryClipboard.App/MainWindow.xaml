<Window x:Class="HistoryClipboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史粘贴板"
        Width="390"
        Height="560"
        MinWidth="320"
        MinHeight="420"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="ToolWindow">
    <Window.Resources>
        <Style x:Key="BlueFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border
                            Margin="2"
                            BorderBrush="#2470A8"
                            BorderThickness="2"
                            CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#EAF6FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="20,20,20,8"
            FontSize="24"
            FontWeight="SemiBold"
            Text="历史粘贴板" />

        <Border
            Grid.Row="1"
            Margin="20,0,20,12"
            Padding="10,6"
            Background="#D8EEFC"
            CornerRadius="8">
            <TextBlock
                x:Name="StatusText"
                Foreground="#405A6B"
                Text="正在启动剪贴板监听…"
                TextWrapping="Wrap" />
        </Border>

        <Border
            Grid.Row="2"
            Margin="20,0,20,12"
            Padding="12,8"
            Background="#F8FCFF"
            BorderBrush="#B8DCEC"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#26495F"
                    Text="搜索" />
                <TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="1"
                    Margin="12,0,8,0"
                    Padding="0,2"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FocusVisualStyle="{StaticResource BlueFocusVisual}"
                    Foreground="#26495F"
                    TextChanged="OnSearchTextChanged"
                    ToolTip="输入文字片段筛选历史记录" />
                <Border
                    Grid.Column="2"
                    Padding="8,3"
                    Background="#D8EEFC"
                    CornerRadius="9">
                    <TextBlock
                        x:Name="SearchResultText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#2470A8"
                        Text="0 个结果" />
                </Border>
            </Grid>
        </Border>

        <Grid
            Grid.Row="3"
            Margin="20,0">
            <ListBox
                x:Name="HistoryList"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="12"
                            Background="White"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            x:Name="TypeBadge"
                                            Padding="7,2"
                                            Background="#E8F3FA"
                                            CornerRadius="7">
                                            <TextBlock
                                                x:Name="TypeLabel"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="#2470A8"
                                                Text="文字" />
                                        </Border>
                                        <Border
                                            x:Name="PinnedBadge"
                                            Margin="5,0,0,0"
                                            Padding="7,2"
                                            Background="#2470A8"
                                            CornerRadius="7"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="已固定" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="#607080"
                                        Text="{Binding CreatedAtUtc.LocalDateTime, StringFormat={}{0:MM-dd HH:mm}}" />
                                </Grid>
                                <Button
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.HelpText="按 Enter 复制这条历史记录"
                                    AutomationProperties.Name="复制此项"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnCopyItemClicked"
                                    FocusVisualStyle="{StaticResource BlueFocusVisual}"
                                    ToolTip="复制此项">
                                    <Grid>
                                        <Grid
                                            x:Name="ImagePreviewContainer"
                                            MinHeight="72"
                                            Visibility="Collapsed">
                                            <Image
                                                x:Name="PreviewImage"
                                                MaxWidth="320"
                                                MaxHeight="180"
                                                Source="{Binding ImagePath}"
                                                Stretch="Uniform" />
                                            <Border
                                                Padding="16"
                                                Background="#F4F8FA"
                                                BorderBrush="#B8DCEC"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Source, ElementName=PreviewImage}"
                                                                Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Foreground="#405A6B"
                                                        Text="图片文件不可用" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="#607080"
                                                        Text="可以删除这条失效记录"
                                                        TextAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            x:Name="TextContentBlock"
                                            MaxHeight="76"
                                            Foreground="#203A4A"
                                            Text="{Binding TextContent}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,9,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,6,0"
                                        Padding="9,4"
                                        AutomationProperties.Name="固定或取消固定此项"
                                        BorderThickness="0"
                                        Click="OnTogglePinClicked"
                                        FontSize="11"
                                        FontWeight="SemiBold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#E8F3FA" />
                                                <Setter Property="Content" Value="固定" />
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource BlueFocusVisual}" />
                                                <Setter Property="Foreground" Value="#2470A8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Background" Value="#2470A8" />
                                                        <Setter Property="Content" Value="取消固定" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Padding="9,4"
                                        AutomationProperties.Name="删除此项"
                                        Background="#FFF1F1"
                                        BorderThickness="0"
                                        Click="OnDeleteItemClicked"
                                        Content="删除"
                                        FocusVisualStyle="{StaticResource BlueFocusVisual}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#A34848" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Image">
                                <Setter TargetName="TypeBadge" Property="Background" Value="#D8EEFC" />
                                <Setter TargetName="TypeLabel" Property="Text" Value="图片" />
                                <Setter TargetName="ImagePreviewContainer" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TextContentBlock" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinnedBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border
                x:Name="EmptyStatePanel"
                Padding="24"
                AutomationProperties.LiveSetting="Polite"
                Background="#F8FCFF"
                BorderBrush="#B8DCEC"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="EmptyStateBadge"
                        Margin="0,0,0,12"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Background="#D8EEFC"
                        CornerRadius="9">
                        <TextBlock
                            x:Name="EmptyStateBadgeText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#2470A8"
                            Text="Ctrl + C" />
                    </Border>
                    <TextBlock
                        x:Name="EmptyStateTitleText"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#26495F"
                        Text="还没有历史记录" />
                    <TextBlock
                        x:Name="EmptyStateDescriptionText"
                        MaxWidth="250"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Foreground="#607080"
                        Text="复制一段文字或截取图片后，会出现在这里。"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.Row="4"
            Margin="20,10,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#607080"
                    Text="全部历史" />
                <Border
                    Margin="0,0,6,0"
                    Padding="8,3"
                    Background="#FFFFFF"
                    CornerRadius="9">
                    <TextBlock
                        x:Name="TextCountText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#26495F"
                        Text="0 条文字" />
                </Border>
                <Border
                    Padding="8,3"
                    Background="#D8EEFC"
                    CornerRadius="9">
                    <TextBlock
                        x:Name="ImageCountText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#2470A8"
                        Text="0 张图片" />
                </Border>
            </StackPanel>
            <Grid
                Grid.Row="1"
                Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="PauseCaptureButton"
                    Padding="10,5"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="暂停或恢复剪贴板捕获"
                    BorderThickness="0"
                    Click="OnToggleCaptureClicked"
                    FontSize="11"
                    FontWeight="SemiBold">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#E8F3FA" />
                            <Setter Property="Content" Value="暂停捕获" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource BlueFocusVisual}" />
                            <Setter Property="Foreground" Value="#2470A8" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#2470A8" />
                                    <Setter Property="Content" Value="恢复捕获" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button
                    Grid.Column="1"
                    Padding="10,5"
                    AutomationProperties.Name="清空全部历史记录"
                    Background="#FFF1F1"
                    BorderThickness="0"
                    Click="OnClearHistoryClicked"
                    Content="清空全部"
                    FocusVisualStyle="{StaticResource BlueFocusVisual}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#A34848" />
            </Grid>
            <Expander
                x:Name="HistorySettingsExpander"
                Grid.Row="2"
                Margin="0,8,0,0"
                AutomationProperties.Name="历史设置"
                FocusVisualStyle="{StaticResource BlueFocusVisual}"
                Foreground="#26495F"
                Header="历史设置">
                <Border
                    Margin="0,6,0,0"
                    Padding="10,8"
                    Background="#F8FCFF"
                    BorderBrush="#B8DCEC"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#26495F"
                                Text="保留未固定记录" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                Foreground="#607080"
                                Text="固定记录不会过期" />
                        </StackPanel>
                        <ComboBox
                            x:Name="RetentionComboBox"
                            Grid.Column="1"
                            Width="78"
                            Padding="5,3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="历史记录保留期限"
                            DisplayMemberPath="Label"
                            FocusVisualStyle="{StaticResource BlueFocusVisual}"
                            SelectedValuePath="Value"
                            SelectionChanged="OnRetentionChanged"
                            ToolTip="选择未固定历史记录的保留天数" />
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,10,12,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#26495F"
                                Text="全局快捷键" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                Foreground="#607080"
                                Text="冲突时应用仍可通过托盘使用" />
                        </StackPanel>
                        <ComboBox
                            x:Name="HotkeyComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="116"
                            Margin="0,10,0,0"
                            Padding="5,3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="全局快捷键"
                            DisplayMemberPath="Label"
                            FocusVisualStyle="{StaticResource BlueFocusVisual}"
                            SelectedValuePath="Value"
                            SelectionChanged="OnHotkeyChanged"
                            ToolTip="选择或禁用用于显示和隐藏历史窗口的全局快捷键" />
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,10,12,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#26495F"
                                Text="登录后自动启动" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                Foreground="#607080"
                                Text="仅为当前 Windows 用户启用" />
                        </StackPanel>
                        <CheckBox
                            x:Name="LaunchAtLoginCheckBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,10,0,0"
                            Padding="5,3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="登录后自动启动历史剪贴板"
                            Checked="OnLaunchAtLoginChanged"
                            Content="启用"
                            FocusVisualStyle="{StaticResource BlueFocusVisual}"
                            ToolTip="在当前 Windows 用户登录后自动启动历史剪贴板"
                            Unchecked="OnLaunchAtLoginChanged" />
                    </Grid>
                </Border>
            </Expander>
            <TextBlock
                Grid.Row="3"
                Margin="0,7,0,0"
                FontSize="11"
                Foreground="#607080"
                Text="关闭窗口后仍会在系统托盘继续记录。"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
